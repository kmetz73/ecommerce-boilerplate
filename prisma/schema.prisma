generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model User {
  id       Int       @id @default(autoincrement())
  clerkId  String    @unique @map("clerk_id")
  name     String
  email    String    @unique
  role     Role      @default(USER)
  products Product[]
  reviews  Review[]

  @@map("users")
}

model Product {
  uuid           String           @id @default(uuid()) @db.Uuid
  slug           String           @unique
  name           String
  description    String?
  priceCents     Int              @map("price_cents")
  salePriceCents Int?             @map("sale_price_cents")
  active         Boolean          @default(true)
  ownerId        Int              @map("owner_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]

  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productUuid String   @map("product_uuid") @db.Uuid
  objectKey   String   @unique @map("object_key")
  altText     String   @map("alt_text")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  uuid           String   @id @default(uuid()) @db.Uuid
  productUuid    String   @map("product_uuid") @db.Uuid
  sku            String   @unique
  optionValues   Json     @map("option_values")
  priceCents     Int?     @map("price_cents")
  salePriceCents Int?     @map("sale_price_cents")
  stockQuantity  Int      @default(0) @map("stock_quantity")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid])
  @@map("product_variants")
}

model Review {
  uuid        String       @id @default(uuid()) @db.Uuid
  productUuid String       @map("product_uuid") @db.Uuid
  userId      Int          @map("user_id")
  rating      Decimal      @db.Decimal(3, 2)
  body        String?
  status      ReviewStatus @default(PUBLISHED)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productUuid, userId])
  @@index([productUuid, status])
  @@map("reviews")
}
