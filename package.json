{
  "name": "ecommerce-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test": "node scripts/verify-database.mjs",
    "admin:promote": "node --env-file=.env scripts/promote-admin.mjs",
    "docs:structure": "pwsh -NoProfile -File ./scripts/generate-project-structure.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^18.0.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "prisma": "7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
